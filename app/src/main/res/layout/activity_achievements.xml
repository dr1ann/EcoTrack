<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/achievementsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    tools:context=".AchievementsActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/achievementsToolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:title="Achievements"
        app:titleTextColor="@color/forest"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:titleTextAppearance="@style/TextAppearance.EcoTrack.Toolbar"
        app:logo="@drawable/ic_badge"
        app:titleMarginStart="8dp" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/achievementsToolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                style="@style/Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Look how far you have come."
                android:textSize="24sp" />
            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:text="Every small action adds up." />
            <com.google.android.material.card.MaterialCardView
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/forest"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="YOUR OVERALL PROGRESS"
                        android:textColor="@color/on_forest"
                        android:textSize="10sp"
                        android:letterSpacing="0.1" />
                    <TextView
                        android:id="@+id/tvCompletionPercent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textSize="46sp"
                        android:textColor="@color/white"
                        android:fontFamily="sans-serif-medium"
                        tools:text="20%" />
                    <TextView
                        android:id="@+id/tvCompletionCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textColor="@color/on_forest"
                        tools:text="3 / 15 challenges completed" />
                    <ProgressBar
                        android:id="@+id/progressCompletion"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="16dp"
                        android:max="100"
                        android:progressTint="@color/on_forest"
                        android:progressBackgroundTint="#51826B"
                        tools:progress="20" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Your milestones"
                android:textSize="20sp" />
            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Small wins worth celebrating."
                android:textSize="13sp" />
            <LinearLayout
                android:id="@+id/milestoneSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">
                <TextView
                    android:id="@+id/milestoneThree"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_milestone"
                    android:gravity="center"
                    android:text="3 challenges"
                    android:textColor="@color/navigation_text"
                    android:textSize="12sp"
                    tools:selected="true" />
                <TextView
                    android:id="@+id/milestoneSix"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_milestone"
                    android:gravity="center"
                    android:text="6 challenges"
                    android:textColor="@color/navigation_text"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/milestoneTen"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_milestone"
                    android:gravity="center"
                    android:text="10 challenges"
                    android:textColor="@color/navigation_text"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/milestoneFifteen"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_milestone"
                    android:gravity="center"
                    android:text="15 challenges"
                    android:textColor="@color/navigation_text"
                    android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        style="@style/Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Earned badges"
                        android:textSize="18sp"
                        android:drawableStart="@drawable/ic_badge"
                        android:drawablePadding="10dp" />
                    <TextView
                        android:id="@+id/tvBadges"
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="6dp"
                        android:textSize="14sp"
                        tools:text="Green Starter - 3 completed" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Practice milestones: 3, 6, 10, and 15 completed. These thresholds are team-defined. Badges reflect your current progress."
                android:textSize="11sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        style="@style/Widget.EcoTrack.BottomNavigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintWidth_max="328dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/main_navigation" />
</androidx.constraintlayout.widget.ConstraintLayout>
