<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    tools:context=".MainActivity"
    tools:layout_width="360dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_grip" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CHALLENGE DETAILS"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:letterSpacing="0.1" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseSheet"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:text="Close"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvSheetTitle"
            style="@style/Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="25sp"
            tools:text="Plastic-Free Week" />
        <TextView
            android:id="@+id/tvSheetCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_status_complete"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="12sp"
            android:textColor="@color/forest"
            tools:text="Waste Reduction" />
        <TextView
            android:id="@+id/tvSheetDescription"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            tools:text="DEMO PLACEHOLDER: Avoid single-use plastics. Carry a reusable bag, bottle, and container." />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_status_idle">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ESTIMATED TIME"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvSheetTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="14sp"
                    android:textColor="@color/ink"
                    android:fontFamily="sans-serif-medium"
                    tools:text="7 days (demo)" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_status_complete">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IMPACT SCORE"
                    android:textColor="@color/forest"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvSheetImpact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="14sp"
                    android:textColor="@color/forest"
                    android:fontFamily="sans-serif-medium"
                    tools:text="5 / 5 (demo)" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Impact ranges from 1 to 5; 5 is the highest."
            android:textSize="11sp" />
        <TextView
            style="@style/Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Your progress"
            android:textSize="18sp" />
        <RadioGroup
            android:id="@+id/radioStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:checkedButton="@id/statusNotStarted">
            <RadioButton
                android:id="@+id/statusNotStarted"
                style="@style/StatusOption"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Not Started" />
            <RadioButton
                android:id="@+id/statusInProgress"
                style="@style/StatusOption"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="In Progress" />
            <RadioButton
                android:id="@+id/statusCompleted"
                style="@style/StatusOption"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Completed" />
        </RadioGroup>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save status"
            app:cornerRadius="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetBookmark"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save challenge"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_bookmark"
            app:iconGravity="textStart" />
    </LinearLayout>
</ScrollView>
